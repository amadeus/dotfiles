[core]
	editor = nvim
	excludesfile = /Users/amadeus/.gitignore
	quotepath = false
	pager = less -FRX
	untrackedCache = true

[pull]
	rebase = true

[push]
	default = upstream
	autoSetupRemote = true

[user]
	name = Amadeus Demarzi
	email = amadeusdemarzi@gmail.com
	username = amadeus

[checkout]
	defaultRemote=origin

[alias]
	co = checkout
	br = branch
	ci = commit
	st = status
	unstage = reset HEAD --
	prettylog = log --graph --decorate --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %C(bold blue)<%an>%Creset %Cgreen(%ad)' --abbrev-commit --date=default
	lola = log --graph --decorate --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %C(bold blue)<%an>%Creset %Cgreen(%ad)' --abbrev-commit --all --date=relative

[color]
	ui = true
	branch = auto
	diff = auto
	interactive = auto
	status = auto

[credential]
	helper = osxkeychain

[diff]
	algorithm = histogram

[difftool]
	prompt = false

[mergetool]
	prompt = false

[branch]
	autosetuprebase = always

[help]
	autocorrect = 1

[url "git@github.com:"]
	insteadOf = https://github.com/

[github]
	user = amadeus

[init]
	defaultBranch = main

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true

[rerere]
	enabled = true

[fetch]
	prune = true

[rebase]
	autosquash = true
	autostash = true

[feature]
	manyFiles = true
