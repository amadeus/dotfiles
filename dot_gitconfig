[core]
	editor = nvim
	excludesfile = /Users/amadeus/.gitignore
	quotepath = false
	pager = less -FRX

[pull]
	default = upstream
	rebase = true

[push]
	default = upstream
	autoSetupRemote = true

[user]
	name = Amadeus Demarzi
	email = amadeusdemarzi@gmail.com
	username = amadeus

[checkout]
	defaultRemote=origin

[alias]
	co = checkout
	br = branch
	ci = commit
	st = status
	unstage = reset HEAD --
	prettylog = log --graph --decorate --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %C(bold blue)<%an>%Creset %Cgreen(%ad)' --abbrev-commit --date=default
	lola = log --graph --decorate --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %C(bold blue)<%an>%Creset %Cgreen(%ad)' --abbrev-commit --all --date=relative

[color]
	ui = true
	branch = auto
	diff = auto
	interactive = auto
	status = auto

[credential]
	helper = osxkeychain

[difftool "ksdiff"]

[diff]
	algorithm = patience
	tool = Kaleidoscope

[difftool]
	prompt = false

[merge]
	tool = Kaleidoscope

[mergetool "splice"]
	cmd = "nvim $BASE $LOCAL $REMOTE $MERGED -c 'SpliceInit'"
	trustExitCode = true

[mergetool "Kaleidoscope"]
	cmd = ksdiff --merge --output \"$MERGED\" --base \"$BASE\" -- \"$LOCAL\" --snapshot \"$REMOTE\" --snapshot
	trustExitCode = true

[mergetool]
	prompt = false

[branch]
	autosetuprebase = always

[help]
	autocorrect = 1

[filter "media"]
	clean = git-media-clean %f
	smudge = git-media-smudge %f
[url "git@github.com:"]
	insteadOf = https://github.com/
[github]
	user = amadeus
[difftool "Kaleidoscope"]
	cmd = ksdiff --partial-changeset --relative-path \"$MERGED\" -- \"$LOCAL\" \"$REMOTE\"
[url "\"git@github.com:\""]
	insteadOf = \"https://github.com/\"
[init]
	defaultBranch = main
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
