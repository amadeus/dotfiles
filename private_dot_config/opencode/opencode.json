{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "command": ["bun", "x", "chrome-devtools-mcp"],
      "enabled": true
    },
    "firefox-devtools": {
      "type": "local",
      "command": ["bun", "x", "@mozilla/firefox-devtools-mcp-moz"],
      "enabled": true,
      "timeout": 30000
    },
    "safari": {
      "type": "local",
      "command": ["bun", "x", "safari-mcp"],
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": ["bun", "x", "@playwright/mcp"],
      "enabled": true
    }
  }
}
