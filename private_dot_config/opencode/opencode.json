{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "file:///Users/amadeus/.config/opencode/plugins/openai-codex-crest.mjs"
  ],
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "command": ["bun", "x", "chrome-devtools-mcp"],
      "enabled": true
    },
    "firefox-devtools": {
      "type": "local",
      "command": ["npx", "-y", "@mozilla/firefox-devtools-mcp-moz"],
      "enabled": true,
      "timeout": 30000
    },
    "playwright": {
      "type": "local",
      "command": ["bun", "x", "@playwright/mcp"],
      "enabled": true
    }
  }
}
