# Fonts
# window-title-font-family="Berkeley Mono"
font-family="Berkeley Mono"
font-size=16
font-thicken=true

# Window / UI Settings
window-padding-x=4,4
window-padding-y=1,1
window-padding-balance=false
window-padding-color=extend
window-step-resize=false

window-vsync=true
# Defining no window size should allow ghostty to remember from the previous
# session
# window-width=120
# window-height=30
window-theme=dark
window-decoration=auto
macos-titlebar-style=tabs
macos-non-native-fullscreen=visible-menu
mouse-hide-while-typing=true
copy-on-select=false
mouse-scroll-multiplier=1

# Not sure if this has a worthwhile effect...
window-colorspace=display-p3

# Icon Settings
macos-icon=xray

adjust-cursor-thickness=3
adjust-underline-thickness=-1

# lets goooooo
scrollback-limit=1000000000

# Updater settings
auto-update=check
auto-update-channel=tip

# Trying out a custom cursor shader, for the memes
custom-shader=./cursor_smear_fade.glsl

# I need this keybind in neovim for gitsigns plugin...
keybind = cmd+shift+j=unbind
keybind = shift+enter=text:\n

