# Fonts
# window-title-font-family="Berkeley Mono"
font-family="Berkeley Mono"
font-size=16
font-thicken=true

# Window / UI Settings
window-padding-x=8,8
window-padding-y=0,2
window-padding-balance=false
window-padding-color=extend
window-step-resize=false

window-vsync=true
# Defining no window size should allow ghostty to remember from the previous
# session
# window-width=120
# window-height=30
window-theme=dark
window-decoration=auto
macos-titlebar-style=tabs
macos-non-native-fullscreen=visible-menu
mouse-hide-while-typing=true
copy-on-select=false
mouse-scroll-multiplier=1

# Not sure if this has a worthwhile effect...
window-colorspace=display-p3

# Icon Settings
macos-icon=xray

adjust-cursor-thickness=3
adjust-underline-thickness=-1

# lets goooooo
scrollback-limit=1000000000

# Updater settings
auto-update=check
auto-update-channel=tip

# Trying out a custom cursor shader, for the memes
custom-shader=./cursor_smear_fade.glsl

# I need this keybind in neovim for gitsigns plugin...
keybind = cmd+shift+j=unbind
keybind = shift+enter=text:\n

# Vim-mode keybindings for Ghostty. (courtesy of hitchellm)
# Key table definition
keybind = vim/

# Entry point
keybind = ctrl+w>n=activate_key_table:vim
keybind = ctrl+w>escape=end_key_sequence
keybind = ctrl+w>ctrl+w=end_key_sequence

# Line movement
keybind = vim/ctrl+e=scroll_page_lines:1
keybind = vim/ctrl+y=scroll_page_lines:-1

# Page movement
keybind = vim/ctrl+d=scroll_page_down
keybind = vim/ctrl+u=scroll_page_up
keybind = vim/ctrl+f=scroll_page_down
keybind = vim/ctrl+b=scroll_page_up
keybind = vim/shift+j=scroll_page_down
keybind = vim/shift+k=scroll_page_up

# Jump to top/bottom
keybind = vim/g>g=scroll_to_top
keybind = vim/shift+g=scroll_to_bottom

# Search (if you want vim-style search entry)
keybind = vim/slash=start_search
keybind = vim/n=navigate_search:next

# Copy mode / selection
# Note we're missing a lot of actions here to make this more full featured.
keybind = vim/v=copy_to_clipboard
keybind = vim/y=copy_to_clipboard

# Command Palette
keybind = vim/shift+semicolon=toggle_command_palette

# Exit but stay in place
keybind = vim/q=deactivate_key_table

# Exit but return to promps
keybind = vim/escape=ignore
keybind = chain=scroll_to_bottom
keybind = chain=deactivate_key_table

keybind = vim/i=ignore
keybind = chain=scroll_to_bottom
keybind = chain=deactivate_key_table

# Catch unbound keys
keybind = vim/catch_all=ignore

