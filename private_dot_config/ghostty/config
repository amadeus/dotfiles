# Fonts
window-title-font-family="Berkeley Mono"
font-family="Berkeley Mono"
font-size=16
font-thicken=true

# Window / UI Settings
window-padding-x=4
window-padding-y=4
window-padding-balance=true
window-step-resize=true
window-vsync=true
window-width=120
window-height=30
window-theme=dark
macos-titlebar-style=hidden
macos-titlebar-proxy-icon=hidden
mouse-hide-while-typing=true
copy-on-select=false
# Not sure if this has a worthwhile effect...
# window-colorspace=display-p3

# Icon Settings - Does not appear to work at the moment?
macos-icon="blueprint"
# macos-icon-frame=plastic

adjust-cursor-thickness=3
adjust-underline-thickness=-1

# lets goooooo
scrollback-limit=1000000000

# Updater settings
auto-update=check
auto-update-channel=tip

# Trying out a custom cursor shader, for the memes
custom-shader=./cursor_smear_fade.glsl

# I need this keybind in neovim for gitsigns plugin... 
keybind = cmd+shift+j=unbind
keybind = shift+enter=text:\x1b\r
