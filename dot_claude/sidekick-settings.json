{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/sidekick-notify\" waiting"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/sidekick-notify\" waiting"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/sidekick-notify\" permission"
          }
        ]
      },
      {
        "matcher": "elicitation_dialog|agent_needs_input",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/sidekick-notify\" waiting"
          }
        ]
      }
    ]
  }
}
